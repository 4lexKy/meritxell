# Informa pel grup d'estadistiques que es reinicia/reseteja
# Comprovacio inicial de programes necessaris
# Passar a funcions tot el case principal










    #FUNCIONES
source ./lib/datos.sh
source ./lib/funcions.sh




    #Esquema:
#Escucha a Meritxell
#Cuando reciba mensaje  # de momento no -> espera 7 segundos para nuevos mensajes
#     Envia texto a ia en ollama
#     Espera respuesta
#     Reenvía respuesta
#Vuelte a esperar Mensajes

    #Texto inicial API
echo
echo -e "\t#######################################################"
echo -e "\t#                                                     #"
echo -e "\t#    API para conectar Ollama con bot de Telegram     #"
echo -e "\t#                   Versión: $version                  #"
echo -e "\t#                                                     #"
echo -e "\t#     $colorInicio[ 9.03.26-01:54:16]$normal -> Espera de nuevo mensaje  #"
echo -e "\t#                                                     #"
echo -e "\t#     $colorLinux[ 9.03.26-01:54:16]$normal -> Proceso de Linux         #"
echo -e "\t#                                                     #"
echo -e "\t#     $colorOllama[ 9.03.26-01:54:16]$normal -> Proceso de IAs           #"
echo -e "\t#                                                     #"
echo -e "\t#     $colorTelegram[ 9.03.26-01:54:16]$normal -> Proceso de Telegram      #"
echo -e "\t#                                                     #"
echo -e "\t#     $colorAviso[ 9.03.26-01:54:16]$normal -> Aviso de acción inusual  #"
echo -e "\t#                                                     #"
echo -e "\t#######################################################"

#Aviso a Alex del inicio de la API
# Función para escapar los caracteres de MarkdownV2 de la IA
escape_md() {
    local txt="$1"
    txt="${txt//_/\\_}"
    txt="${txt//*/\\*}"
    txt="${txt//[/\\[}"
    txt="${txt//]/\\]}"
    txt="${txt//(/\\(}"
    txt="${txt//)/\\)}"
    txt="${txt//~/\\~}"
    txt="${txt//\`/\\\`}"
    txt="${txt//>/\\>}"
    txt="${txt//#/\\#}"
    txt="${txt//+/\\+}"
    txt="${txt//-/\\-}"
    txt="${txt//= /\\=}"
    txt="${txt//|/\\|}"
    txt="${txt//\{ /\\{ }"
    txt="${txt//\}/\\}}"
    txt="${txt//./\\.}"
    txt="${txt//!/\\!}"
    echo "$txt"
}
respuestaIa=$(fecha)"La API *meritxell.api* $version 🟢 activada desde $(hostname)"
respuestaEsc=$(escape_md "$respuestaIa")

#Para que muestre todo se usa esto, sin el parse markdown, pero también hace que telegram no muestre
#curl -s -X POST https://api.telegram.org/$botToken/sendMessage -H "Content-Type: application/json" -d "{\"chat_id\":\"-4996150704\",\"text\":\"$respuestaIa\"}" > /dev/null #El ! hay que escaparlo
enviarMensajeSinCitar "$botToken" "$idChatEstadisticas" "$respuestaIa"

respuestaIa=""
echo
fecha $colorInicio
echo "Inicio informado."





    #Bucle Principal
for ((;;)); do
        #Caso /reset
    if (( bitReset == 1 )); then
        #Necesita consumir mensaje anterior para no quedare en bucle de cerrado.
        curl -s "https://api.telegram.org/$botToken/getUpdates?offset=${ultimoMensaje}&timeout=1" >/dev/null 2>&1

#         #Informa de que es tanca el programa
#         ctrl_c

        fecha $colorAviso
        echo "Cerrada instancia anterior"
        exit
    fi

        #Esperando mensajes con long polling
    fecha $colorInicio
    echo -n "Esperando mensaje >$ultimoMensaje< a Meritxell en Telegram"
    res=$(curl -s "https://api.telegram.org/$botToken/getUpdates?offset=${ultimoMensaje}&timeout=$timeoutDeEscuchaTelegram")
    #res=$(curl -s "https://api.telegram.org/$botToken/getUpdates?timeout=300")

        #Procesamos mensaje
    echo
    fecha $colorLinux
    echo "Procesando mensaje..."
    #Obteniendo variables Parte 1
    ultimoMensaje=$(echo $res | jq -r '.result[0].update_id')

        #Respondemos mensaje
    if [[ "$ultimoMensaje" != "null" ]]; then
        ultimoMensaje=$((ultimoMensaje + 1))  #Marcamos como leido el mensaje

        #Obteniendo variables Parte 2
           idAutor=$(echo $res | jq -r '.result[0].message.from.id')
            nombre=$(echo $res | jq -r '.result[0].message.from.first_name')
          apellido=$(echo $res | jq -r '.result[0].message.from.last_name')
        chatOrigen=$(echo $res | jq -r '.result[0].message.chat.id')
        chatNombre=$(echo $res | jq -r '.result[0].message.chat.title')
         idMensaje=$(echo $res | jq -r '.result[0].message.message_id')
             texto=$(echo $res | jq -r '.result[0].message.text')
        #Escapamos texto de entrada, los " y \
        texto=$(echo -e $texto | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')

            #Obteniendo variables Parte 3    (versión de imagen más grande)
        #Obtiene lista de imagenes
        idImagen=$(echo "$res" | jq -c '.result[0].message.photo[0]')
        #Si es una imagen
        if [[ "$idImagen" != "null" && "$idImagen" != "" ]]; then
            #Obtiene lista de imagenes
            idImagen=$(echo "$res" | jq -c '.result[0].message.photo[]')
            #Obtenemos el comentario de la foto
            comentarioFoto=$(echo $res | jq -r '.result[0].message.caption')
            #Nos quedamos con la imagen más grande
            anchoMax=0
            while IFS= read -r foto; do
                    imgAncho=$(echo "$photo" | jq -r '.width')
                if (( anchoMax <= imgAncho )); then
                    idImagen=$(echo "$foto" | jq -r '.file_id')
                    #Datos que no uso de la imagen:
                    #idImagenU=$(echo "$photo" | jq -r '.file_unique_id')
                    #   imgTam=$(echo "$photo" | jq -r '.file_size')
                    #   imgAlto=$(echo "$foto" | jq -r '.height')
                fi
            done < <(printf '%s\n' "$idImagen")
        fi

        #Informando a consola
        fecha $colorLinux
        echo -e "Autor $idAutor en $chatNombre($chatOrigen)"
        fecha $colorLinux
        echo -e "Texto recibido >$texto<"

        #Guardando en historial
        echo -e $(fecha)"\n\tAutor\n$nombre($idAutor)\n\tMensaje:\n$texto\n\n" >> ./interno/historial
        fecha $colorLinux
        echo -e "Pregunta guardada en ./interno/historial"

            #Gestión de usuarios
        #Comprobamos que el id esté en la lista blanca.
        fecha $colorLinux
        echo "Autenticando usuario..."
        enListaBlanca "$idAutor" "$chatOrigen"
        autorizado=$?
        #Si es de alguien conocido o Alex, entras
        if [[  "$idAutor" == "$idAlex" || "$autorizado" == "1" ]]; then
            #Informamos
            fecha $colorLinux
            echo "Confirmado remitente: $nombre ($idAutor)"

            #Carga del contexto
            if [[ -e "./contexto/ctxt$idAutor.txt" ]]; then
                contexto=$(cat "./contexto/ctxt$idAutor.txt")
            else
                fecha $colorLinux
                echo "Nuevo Usuario (sin registro previo)"
                > ./contexto/ctxt$idAutor.txt
                respuestaIa="Sembla que no hem parlat mai. Sols tenim un contex, per borrar-lo usa /clear ."
                enviarMensajeSinCitar "$botToken" "$chatOrigen" "$respuestaIa"
            fi

            #Switch de acción
            case "$texto" in
                /comds)
                    if [[  "$idAutor" == "$idAlex" ]]; then
                        misComandos="{\"command\":\"help\",\"description\":\"¿Quí o que es Meritxell?\"}"
                        listaComandos=("models" "utils" "clear")
                        listaDescripciones=("Models disponibles" "Ferramentes útils" "Borra sessió")
                        for i in "${!listaComandos[@]}"; do
                            misComandos=$misComandos",{\"command\":\"${listaComandos[i]}\",\"description\":\"${listaDescripciones[i]}\"}"
                        done

                        curl -s -X POST "https://api.telegram.org/$botToken/setMyCommands" -H "Content-Type: application/json" -d "{\"commands\":[$misComandos],\"scope\": { \"type\": \"default\" } }"
                        echo

                        respuestaIa="S'están actualizant els comandaments"
                    else
                        respuestaIa="Sols l'administrador pot actualizar els comandaments"
                    fi
                    ;;
                /help|/start|/info)
                    respuestaIa=$'Meritxell ('$version$') es un bot per interactuar amb models d\'ia. Elegeix un model dels mostrats amb /models i clica sobre el que preferisques.\\n\\nTambé pots:\\n/clear -> Esborra el context de la ia.\\n/hw -> Curiosetja el hardware.\\n/status -> Consulta l\'estat del sistema.\\n\\nPer a més comandaments... /com'
                    ;;
                /com)
                    respuestaIa="Aquests son els comandaments ocults:\n\n"

                    respuestaIa+="*Informació:*\n"
                    respuestaIa+="/help /info /start -> Informació general.\n"
                    respuestaIa+="/com -> Mostra tots els comandaments.\n"
                    respuestaIa+="\n"
                    respuestaIa+="*Útils:*\n"
                    respuestaIa+="/yt URL -> Descarga vídeo de YT i te'l envia\n"
                    respuestaIa+="/ytn URL -> Descarga vídeo, sols admin.\n"
                    respuestaIa+="/qr TEXT -> Genera un QR amb el text passat.\n"
                    respuestaIa+="\n"
                    respuestaIa+="*Us del chat I.A.:*\n"
                    respuestaIa+="/models /mod -> Mostra els models disponibles.\n"
                    respuestaIa+="/last -> mostra la interacció anterior.\n"
                    respuestaIa+="/clear -> Neteja el context de la ia.\n"
                    respuestaIa+="\n"
                    respuestaIa+="*Curiositat malsana*\n"
                    respuestaIa+="/hw -> Mostra el hardware actual.\n"
                    respuestaIa+="/status -> Mostra l'estat del hardware.\n"
                    respuestaIa+="/comds -> Actualitza els comandaments.\n"
                    respuestaIa+="/apagar -> Apaga Meritxell.\n"
                    respuestaIa+="/reiniciar -> Reinicia Meritxell.\n"
                    respuestaIa+="/reset -> Reinicia i elimina arxius temporals.\n"

                    ;;
                /models|/mod)
                    respuestaIa=$( curl -s http://localhost:11434/api/tags )

                    #Obtener los nombres y peso de todos los modelos que hay instalados
                    nombres=$(echo $respuestaIa | jq -r '.models[].name')
                       peso=$(echo $respuestaIa | jq -r '.models[].size')

                    #Convertir lineas en elementos de un vector
                    IFS=$'\n'   # separador = espacio
                    read -r -d '' -a listaNombres <<< "$nombres"
                    read -r -d '' -a listaPesos <<< "$peso"

                    #Generamos el texto
                    respuestaIa=">>>Model actual: *$modelo*\n"
                    respuestaIa+=">>>Màquina actual: *$(hostname)*\n\n"
                    for i in "${!listaNombres[@]}"; do
                        #Generar comandos
                        comm="run_${listaNombres[i]}"
                        comm="/$(echo -e $comm | sed -e 's/_/X/g' -e 's/:/X/g' -e 's/\//X/g'  -e 's/-/X/g')"

                        #Adaptamos memoria a algo legible
                        peso=$(mostrarPesoEnHumano "${listaPesos[i]}")
                        peso="\`$peso\`"

                        #Generar lista
                        respuestaIa="$respuestaIa\($peso\) ${listaNombres[i]} $comm\n\n"
                    done
                    ;;
                /status)
                    respuestaIa="No imlementat de moment..."
                    ;;
                /hw)
                    #Mostramos mi comando sis + le quitamos los caracteres de los colores + sustituimos endl por \n para telegram
                    respuestaIa=$(sis | sed $'s/\x1b\[[0-9;]*m//g' | sed ':a;N;$!ba;s/\n/\\n/g')
#                     respuestaIa=$(hostnamectl && lscpu | grep "Nombre del modelo:" && lscpu | grep "CPU(s):" && lscpu | grep "Operating System" && lscpu | grep "Kernel" )
                    ;;
                /clear)
                    contexto=""
                    > "./contexto/ctxt$idAutor.txt"
                    respuestaIa="Context de $nombre($idAutor) borrat"
                    ;;
                /run*)
                    #Obtenemos nombres reales
                    respuestaIa=$( curl -s http://localhost:11434/api/tags )
                    nombres=$(echo $respuestaIa | jq -r '.models[].name')
                    #Convertir lineas en elementos de un vector
                    IFS=$'\n'   # separador = espacio
                    read -r -d '' -a listaNombres <<< "$nombres"
                    #Comparar lista de comandos
                    encontrado=0
                    for i in "${!listaNombres[@]}"; do
                        #Generar comandos
                        nom="run_${listaNombres[i]}"

                        #Traducir con mismo escapado
                        nom="/$(echo -e $nom | sed -e 's/_/X/g' -e 's/:/X/g' -e 's/\//X/g'  -e 's/-/X/g')"

                        #Comparamos con comando introducido
                        if [ "$nom" = "$texto" ]; then
                            #Si alguno es igual
                            modelo=${listaNombres[i]}
                            encontrado="1"
                        fi
                    done
                    #Si lo hemos encontrado actuamos
                    if (( "$encontrado" == "1" )); then
                        respuestaIa="Ara s'usará el model $modelo."
                    else
                        respuestaIa="No existeix el modelo $texto, selecciona un dels existents. Es mante el model actual: $modelo"
                    fi
                    ;;
                /utils)
                    #Llena la variable de respuesta
                    caseUtils $respuestaIa
                    ;;
                /qr*)
                    #Genera un qr y lo envía de vuelta
                    caseQR
                    ;;
                /yt*|/ytn*)
                    #Informamos de que está trabajando el bot
                    mostrarEscribiendoInfinito "$botToken" "$chatOrigen" &
                    pidEscribiendo=$!
                    #Borramos datos anteriores para no almacenar
                    rutaGuardado="~/scriptsAlex/en_ello/ytdw/ytdw-descargas"
                    rm -rf $rutaGuardado
                    #Mostramos el texto salvo la primera palabra (que será el comando)
                    if [ "${texto#* }" =  "/yt" ]; then #Si solo hay una palabra es que no hay url
                        respuestaIa="Per a usar la descàrrega has d'escriure el comandament /yt seguit del enllaç del vídeo a descarregar així: \"/yt url\""
                    else
                        #Informa en terminal
                        fecha $colorUtiles
                        echo "Descargando enlace: ${texto#* }..."
                        # Obtenemos el nombre de audio y video
                        ficheroAenviarA=-1
                        ficheroAenviarV=-1
                        ficheroAenviarA=$( ~/scriptsAlex/en_ello/ytdw/ytdw "i" "${texto#* }" )
                        ficheroAenviarV=$( ~/scriptsAlex/en_ello/ytdw/ytdw "i" "i" "${texto#* }" )

                            #Comprobamos si debemos enviar y donde guardar
                        #Si el comando es /yt se envia de vuelta el archivo
                        if [ $(echo "$texto" | cut -d' ' -f1) =  "/yt" ]; then
                            #Descarga
                            ~/scriptsAlex/en_ello/ytdw/ytdw "${texto#* }"
                            #Enviamos
                            respuestaIa=""
                            if [ "$ficheroAenviarA" != "-1" ]; then
                                textoInformativo=$( basename "$ficheroAenviarA" )
                                enviarDocumento "$botToken" "$chatOrigen" "$ficheroAenviarA" "$textoInformativo" "$idMensaje"
                                respuestaIa+="Audio enviado.\n"
                            else
                                respuestaIa+="Error en audio.\n"
                            fi
                            if [ "$ficheroAenviarV" != "-1" ]; then
                                textoInformativo=$( basename "$ficheroAenviarV" )
                                echo $ficheroAenviarV
                                enviarDocumento "$botToken" "$chatOrigen" "$ficheroAenviarV" "$textoInformativo" "$idMensaje"
                                respuestaIa+="Video Enviado.\n"
                            else
                                respuestaIa+="Vídeo muy grande para enviar."
                            fi
                            respuestaIa+="\nOperación terminada."
                        else
                            #Si el comando es /ytn solo se almacena
                            #Solo el admin puede usar este comando
                            if [[  "$idAutor" == "$idAlex" ]]; then
                                #Solo descargamos
                                ~/scriptsAlex/en_ello/ytdw/ytdw "${texto#* }"
                                respuestaIa="Descàrga completada en .../scriptsAlex/en-ello/ytdw/ytdw"
                            else
                                respuestaIa="Sols l'administrador pot usar aquesta opció."
                            fi
                        fi
                    fi
                    #Gestion de los procesos en segundo plano
                    kill "$pidEscribiendo" > /dev/null
                    ;;
                /wordToLibree) #No implementat
                    #Informa de enviar el fitxer
                    respuestaIa="Envíame el documento"
                    enviarMensajeSinCitar $botToken $chatOrigen $respuestaIa

                    #Descarrgar el fitxer HHHHHHHHHHHHHHHHHHHHHHProblemes per a descarregar fitxers i text
                    rutaArchivo=$(descargarFichero $idFichero $botToken $idAutor)
                    echo $rutaArchivo

                    #Transformar a PDF
                    pdfGenerado="./temp/"
                    libreoffice --headless --convert-to pdf --outdir $pdfGenerado $rutaArchivo

                    #Enviar PDF
                    ficheroAenvviar=$pdfGenerado
                    enviarDocumento $botToken $chatOrigen $ficheroAenviar $textoInformativo $idMensaje

                    respuestaIa="Document generat."
                    ;;
                /test)  #TEMPORAL, PRUEBAS
#                     curl -s -X POST "https://api.telegram.org/$botToken/sendMessage" \
#                         -H "Content-Type: application/json" \
#                         -d '{
