    # FUNCIONES AUXILIARES
function mostrarPesoEnHumano()  #ARGs: $peso
{
    #Adaptación de variables pasadas como argumento
    peso=$1

    #Obtenemos unidades y convertimos de Bytes a las unidades
#     if (( peso >= 1024**4 )); then # 1024*1024*1024*1024 = 1.048.576.000.000 = 1 TB
#         unidades="TB"
#         echo $unidades
#         (( peso = peso / 1024**4 ))
    if (( peso >= 1073741824 )); then # 1024*1024*1024 = 1.073.741.824 = 1 GB
        unidades="GB"
        peso=$(echo "scale=1;$peso/(1024^3)" | bc)  #scale son los decimales
    elif (( peso >= 1024**2 )); then # 1024*1024 = 1 048 576 = 1 MB
        unidades="MB"
        peso=$(echo "scale=0;$peso/(1024^2)" | bc)
    elif (( peso >= 1024 )); then
        unidades="KB"
        peso=$(echo "scale=0;$peso/1024" | bc)
    else
        unidades="By"
    fi

    echo "$peso $unidades"
}
function escaparMarkdown()  #ARGs: $texto
{
    #Adaptación de variables pasadas como argumento
    texto=$1

    #Sabiduría
#   '...' -> no interpretan su interior
#             Si pones \n no añadiria salto de linea
#   sed -> Uso: -e 's/*/\\*/g'
#               -> sustituye (s) todas las coincidencias (g)
#               -> de * por \* (se escapa la barra -> \\*)
#          Para interpretar: (echo sin -e)
#               -> \
#               necesita-> escapar con \\

    #Caracteres escapados y no escapados:
#  \ -> \\
#  / -> /   #sin escape
#    -e 's/`/\\\\`/g' #funciona, necesito usar ` normal
#  * -> \\* que muestra \*
#  ** -> \*\* -> *
#  _ -> \_
#  { -> \}
#  { -> \{
#  [ -> \[
#  ] -> \]
#  ) -> \)
#  ( -> \(
#  " -> \"
#    -e 's/#/hola/g' \ #Funciona, se muestra solo
#    -e 's/+/\\\\+/g' \ #Funciona, se muestra solo
#    -e 's/-/\\\\-/g' \ #Funciona, se muestra solo
#    -e 's/\./\\\\./g' \ #Funciona, se muestra solo
#    -e 's/\!/\\\\!/g' #Funciona, se muestra solo
#    -e 's/|/\\\\|/g' \ #Funciona, se muestra solo
#    -e 's/>/\\\\>/g' \ #Funciona, se muestra solo
#    -e 's/~/\\\\~/g' #Funciona, se muestra solo
#    -e 's/(/\\(/g' \ #Funciona, se muestra solo
#    -e 's/)/\\)/g' \ #Funciona, se muestra solo
    texto=$(echo -E $texto | sed -e 's/\\/\\\\/g' \
                            -e 's/\//\//g' \
                            -e 's/\*/\\\\*/g' \
                            -e 's/\\\\\*\\\\\*/*/g' \
                            -e 's/_/\\\\_/g' \
                            -e 's/{/\\{/g' \
                            -e 's/}/\\}/g' \
                            -e 's/\[/\\\\[/g' \
                            -e 's/\]/\\]/g' \
                            -e 's/"/\\"/g'
           )
    echo -e $texto
}
function mostrarEscribiendo()  #ARGs: $botToken $chatOrigen
{
    #Adaptación de variables pasadas como argumento
    botToken=$1
    chatOrigen=$2

    curl -s -X POST https://api.telegram.org/$botToken/sendChatAction -H "Content-Type: application/json" -d "{\"chat_id\":\"$chatOrigen\",\"action\":\"typing\" }" > /dev/null
}
function mostrarEscribiendoInfinito()  #ARGs: $botToken $chatOrigen
{
    #Adaptación de variables pasadas como argumento
    botToken=$1
    chatOrigen=$2

    for((;;)); do
        #El "escribiendo" dura unos 5 segundo
        mostrarEscribiendo "$botToken" "$chatOrigen"
        echo -n "#" >&2
        sleep 4
    done
}
function enListaBlanca()  #ARGs: $idAutor $chatOrigen
{
    autorizado=0
    while IFS= read -r linea; do
        read -r idUsuario nombreUsuario _ <<< "$linea"
        if [[ "$idAutor" == "$idUsuario" ]]; then   #Si es un usuario conocido
            autorizado=1
        fi
        if [[ "$chatOrigen" == "$idUsuario" ]]; then #Si es un grupo conocido
            autorizado=1
        fi
    done < ./interno/listaB

    if [[ "$autorizado" == "1" ]]; then #Si es un grupo conocido
        return 1
    else
        return 0
    fi
}
    # FUNCIONES PRINCIPALES
function enviarMensaje() #ARGs: $botToken $chatOrigen $respuestaIa $idMensaje
{
    #Adaptación de variables pasadas como argumento
    botToken=$1
    chatOrigen=$2
    respuestaIa=$3
    idMensaje=$4

    curl -s -X POST https://api.telegram.org/$botToken/sendMessage -H "Content-Type: application/json" -d "{\"chat_id\":\"$chatOrigen\",\"text\":\"$respuestaIa\",\"reply_to_message_id\": \"$idMensaje\", \"parse_mode\":\"Markdown\"}" > /dev/null #El ! hay que escaparlo
}
function enviarMensajeSinCitar()  #ARGs: $botToken $chatOrigen $respuestaIa
{
    #Adaptación de variables pasadas como argumento
    botToken=$1
    chatOrigen=$2
    respuestaIa=$3

    curl -s -X POST https://api.telegram.org/$botToken/sendMessage -H "Content-Type: application/json" -d "{\"chat_id\":\"$chatOrigen\",\"text\":\"$respuestaIa\", \"parse_mode\":\"Markdown\"}" > /dev/null #El ! hay que escaparlo
}
function descargarImagen()  #ARGs: $idImagen $botToken $idAutor
{
    #Adaptación de variables pasadas como argumento
    idImagen=$1
    botToken=$2
    idAutor=$3

        #Descargamos imagen
    #Obtenemos datos de la imagen
    varJson=$(curl -s "https://api.telegram.org/$botToken/getFile?file_id=$idImagen")
    #Extraemos ruta de la imagen
    rutaImg=$(echo "$varJson" | jq -r '.result.file_path')
    #Generamos nombre de la imagen
    nomImg="./img/$idAutor$(fecha).png"
    #Descargamos la image
    curl -s "https://api.telegram.org/file/$botToken/$rutaImg" -o "$nomImg"

    echo $nomImg
}
function llamadaModelo()  #ARGs: $colorOllama $modelo $contexto $texto $botToken $chatOrigen $idAutor
{
    #Adaptación de variables pasadas como argumento
    colorOllama=$1
    modelo=$2
    contexto=$3
    texto=$4
    botToken=$5
    chatOrigen=$6
    idAutor=$7

    #pasa a ollama
    fecha $colorOllama >&2
    echo "Llamando al modelo..." >&2

    echo "{ \"model\": \"$modelo\", \"messages\": [$contexto{\"role\":\"user\",\"content\":\"$texto\"}], \"stream\": false}" > "./temp/consulta$idAutor.temp"

    #Modelo con contexto en segundo plano
    exec 3< <(curl -s -X POST http://localhost:11434/api/chat -H "Content-Type: application/json" -d @"./temp/consulta$idAutor.temp" )
    pidIA=$!

    #Modelo con contexto en segundo plano ( contexto sin imagenes )
#     exec 3< <(curl -s http://localhost:11434/api/chat -d "{ \"model\": \"$modelo\", \"messages\": [$contexto{\"role\": \"user\",\"content\": \"$texto\"}], \"stream\": false}")
#     pidIA=$!

    #Informamos de que está pensando en segundo plano
    fecha $colorOllama >&2
    echo -n "Pensant..." >&2
    mostrarEscribiendoInfinito "$botToken" "$chatOrigen" &
    pidEscribiendo=$!

    #Gestion de los procesos en segundo plano
    wait $pidIA
    kill "$pidEscribiendo" > /dev/null
    echo >&2
    respuestaIa=$(cat <&3)                  #Leemos descriptor
    exec 3<&-                               #Eliminamos descriptor
    rm -f "./temp/consulta$idAutor.temp"    #Eliminamos el archivo temporal

    #Extraigo texto de respuesta
    respuestaIa=$(echo $respuestaIa | jq -r '.message.content')

    #Pasamos respuesta para poder ser enviada
    echo $respuestaIa >&1

    #Escapamos la respuesta de la ia antes de guardarla
    respuestaIa=$(escaparMarkdown "$respuestaIA")

    #Augmentar contexto
    nuevoFragmento='{"role": "user","content":"'$texto'"},{"role": "assistant","content":"'$respuestaIa'"},'
    echo -n $nuevoFragmento >> "contexto/ctxt$idAutor.txt"

    #Vaciado de variables
    contexto=""

        #Modelo sin contexto (1 solo mensaje y se olvida)
    #respuestaIa=$( curl -s http://localhost:11434/api/generate -d "{\"model\": \"$modelo\",\"prompt\": \"${texto}\", \"stream\": false}" )
    #respuestaIa=$(echo $respuestaIa | jq -r '.response')

    fecha $colorOllama >&2
    echo "Respuesta generada" >&2
}
function llamadaModeloImagen()  #ARGs: $colorOllama $modelo $contexto $comentarioFoto $botToken $chatOrigen $idAutor $rutaImagen
{
    #Adaptación de variables pasadas como argumento
    colorOllama=$1
    modelo=$2
    contexto=$3
    comentarioFoto=$4
    botToken=$5
    chatOrigen=$6
    idAutor=$7
    rutaImagen=$8

    #pasa a ollama
    fecha $colorOllama >&2
    echo "Llamando al modelo..." >&2

    #Procesar imagen
    img=$(base64 < $rutaImagen | tr -d '\n')

    #Creamos consulta con contexto e imagen adjunta
    echo "{ \"model\": \"$modelo\", \"messages\": [$contexto{\"role\":\"user\",\"content\":\"$comentarioFoto\",\"images\": [\"$img\"]}], \"stream\": false}" > "./temp/img$idAutor.temp"

    #Modelo con contexto en segundo plano
    exec 3< <(curl -s -X POST http://localhost:11434/api/chat -H "Content-Type: application/json" -d @"./temp/img$idAutor.temp" )
    pidIA=$!

    #Informamos de que está pensando en segundo plano
    fecha $colorOllama >&2
    echo -n "Pensant..." >&2
    mostrarEscribiendoInfinito "$botToken" "$chatOrigen" &
    pidEscribiendo=$!

    #Gestion de los procesos en segundo plano
    wait $pidIA
    kill "$pidEscribiendo" > /dev/null
    echo >&2
    respuestaIa=$(cat <&3)          #Leemos descriptor
    exec 3<&-                       #Eliminamos descriptor
    rm -f "./temp/img$idAutor.temp" #Eliminamos el archivo temporal


    #Extraigo texto de respuesta
    respuestaIa=$(echo $respuestaIa | jq -r '.message.content')

    #Pasamos respuesta para poder ser enviada
    echo $respuestaIa >&1

    #Augmentar contexto
    nuevoFragmento='{"role": "user","content": "'$comentarioFoto'","images": ["'$img'"]},{"role": "assistant","content":"'$respuestaIa'"},'
    echo -n $nuevoFragmento >> "contexto/ctxt$idAutor.txt"

    #Vaciado de variables
    contexto=""

        #Modelo sin contexto (1 solo mensaje y se olvida)
    #respuestaIa=$( curl -s http://localhost:11434/api/generate -d "{\"model\": \"$modelo\",\"prompt\": \"${comentarioFoto}\", \"stream\": false}" )
    #respuestaIa=$(echo $respuestaIa | jq -r '.response')

    fecha $colorOllama >&2
    echo "Respuesta generada" >&2
}



























    #Bucle Principal
for ((;;)); do
        #Esperando mensajes con long polling
    fecha $colorInicio
    echo -n "Esperando mensaje >$ultimoMensaje< a Meritxell en Telegram"
    res=$(curl -s "https://api.telegram.org/$botToken/getUpdates?offset=${ultimoMensaje}&timeout=300")
    #res=$(curl -s "https://api.telegram.org/$botToken/getUpdates?timeout=300")

        #Caso /reset
    if (( bitReset == 1 )); then
        echo
        fecha $colorAviso
        echo "Cerrada instancia anterior"
        exit
    fi

        #Procesamos mensaje
    echo
    fecha $colorLinux
    echo "Procesando mensaje..."
    #Obteniendo variables Parte 1
    ultimoMensaje=$(echo $res | jq -r '.result[0].update_id')

        #Respondemos mensaje
    if [[ "$ultimoMensaje" != "null" ]]; then
        ultimoMensaje=$((ultimoMensaje + 1))  #Marcamos como leido el mensaje

        #Obteniendo variables Parte 2
           idAutor=$(echo $res | jq -r '.result[0].message.from.id')
            nombre=$(echo $res | jq -r '.result[0].message.from.first_name')
          apellido=$(echo $res | jq -r '.result[0].message.from.last_name')
        chatOrigen=$(echo $res | jq -r '.result[0].message.chat.id')
        chatNombre=$(echo $res | jq -r '.result[0].message.chat.title')
         idMensaje=$(echo $res | jq -r '.result[0].message.message_id')
             texto=$(echo $res | jq -r '.result[0].message.text')
        #Escapamos texto de entrada, los " y \
        texto=$(echo -e $texto | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')

            #Obteniendo variables Parte 3    (versión de imagen más grande)
        #Obtiene lista de imagenes
        idImagen=$(echo "$res" | jq -c '.result[0].message.photo[0]')
        #Si es una imagen
        if [[ "$idImagen" != "null" && "$idImagen" != "" ]]; then
            #Obtiene lista de imagenes
            idImagen=$(echo "$res" | jq -c '.result[0].message.photo[]')
            #Obtenemos el comentario de la foto
            comentarioFoto=$(echo $res | jq -r '.result[0].message.caption')
            #Nos quedamos con a imagen más grande
            anchoMax=0
            while IFS= read -r foto; do
                    imgAncho=$(echo "$photo" | jq -r '.width')
                if (( anchoMax <= imgAncho )); then
                    idImagen=$(echo "$foto" | jq -r '.file_id')
                    #Datos que no uso de la imagen:
                    #idImagenU=$(echo "$photo" | jq -r '.file_unique_id')
                    #   imgTam=$(echo "$photo" | jq -r '.file_size')
                    #   imgAlto=$(echo "$foto" | jq -r '.height')
                fi
            done < <(printf '%s\n' "$idImagen")
        fi

        #Informando a consola
        fecha $colorLinux
        echo -e "Autor $idAutor en $chatNombre($chatOrigen)"
        fecha $colorLinux
        echo -e "Texto recibido >$texto<"

        #Guardando en historial
        echo -e $(fecha)"\n\tAutor\n$nombre($idAutor)\n\tMensaje:\n$texto\n\n" >> ./interno/historial
        fecha $colorLinux
        echo -e "Pregunta guardada en ./interno/historial"

            #Gestión de usuarios
        #Comprobamos que el id esté en la lista blanca.
        fecha $colorLinux
        echo "Autenticando usuario..."
        enListaBlanca "$idAutor" "$chatOrigen"
        autorizado=$?
        #Si es de alguien conocido o Alex, entras
        if [[  "$idAutor" == "$idAlex" || "$autorizado" == "1" ]]; then
            #Informamos
            fecha $colorLinux
            echo "Confirmado remitente: $nombre ($idAutor)"

            #Carga del contexto
            if [[ -e "./contexto/ctxt$idAutor.txt" ]]; then
                contexto=$(cat "./contexto/ctxt$idAutor.txt")
            else
                fecha $colorLinux
                echo "Nuevo Usuario (sin registro previo)"
                > ./contexto/ctxt$idAutor.txt
                respuestaIa="Sembla que no hem parlat mai. Sols tenim un contex, per borrar-lo usa /clear ."
                enviarMensajeSinCitar "$botToken" "$chatOrigen" "$respuestaIa"
            fi

            #Switch de acción
            case "$texto" in
                /comandos)
                    misComandos="{\"command\":\"help\",\"description\":\"¿Quí o que es Meritxell?\"}"
                    listaComandos=("models" "clear")
                    listaDescripciones=("Models disponibles" "Borra sessió")
                    for i in "${!listaComandos[@]}"; do
                        misComandos=$misComandos",{\"command\":\"${listaComandos[i]}\",\"description\":\"${listaDescripciones[i]}\"}"
                    done

                    curl -s -X POST "https://api.telegram.org/$botToken/setMyCommands" -H "Content-Type: application/json" -d "{\"commands\":[$misComandos],\"scope\": { \"type\": \"default\" } }"
                    echo

                    respuestaIa="S'están actualizant els comandaments"
                    ;;
                /help|/start|/info)
                    respuestaIa=$'Meritxell ('$version$') es un bot per interactuar amb models d\'ia. Elegeix un model dels mostrats amb /models i clica sobre el que preferisques.\\n\\nTambé pots:\\n/clear -> Esborra el context de la ia.\\n/hw -> Curiosetja el hardware.\\n/status -> Consulta l\'estat del sistema.\\n\\nPer a més comandaments... /com'
                    ;;
                /com)
                    respuestaIa="Aquest son els comandaments ocults:\n\n"
                    respuestaIa+="/help -> Informació general.\n"
                    respuestaIa+="/info -> Ídem a /help.\n"
                    respuestaIa+="/start -> Ídem a /help.\n"
                    respuestaIa+="/com -> Mostra tots els comandaments.\n"
                    respuestaIa+="/last -> mostra la consulta anterior.\n"
                    respuestaIa+="/clear -> Neteja el context de la ia.\n"
                    respuestaIa+="/models -> Mostra els models disponibles.\n"
                    respuestaIa+="/mod -> Ídem a /models.\n"
                    respuestaIa+="/hw -> Mostra el hardware actual.\n"
                    respuestaIa+="/status -> Mostra l'estat del hardware.\n"
                    respuestaIa+="/comandos -> Actualitza els comandaments."

                    ;;
                /models|/mod)
                    respuestaIa=$( curl -s http://localhost:11434/api/tags )

                    #Obtener los nombres y peso de todos los modelos que hay instalados
                    nombres=$(echo $respuestaIa | jq -r '.models[].name')
                       peso=$(echo $respuestaIa | jq -r '.models[].size')

                    #Convertir lineas en elementos de un vector
                    IFS=$'\n'   # separador = espacio
                    read -r -d '' -a listaNombres <<< "$nombres"
                    read -r -d '' -a listaPesos <<< "$peso"

                    #Generamos el texto
                    respuestaIa=">>>Model actual: *$modelo*\n"
                    respuestaIa+=">>>Màquina actual: *$(hostname)*\n\n"
                    for i in "${!listaNombres[@]}"; do
                        #Generar comandos
                        comm="run_${listaNombres[i]}"
                        comm="/$(echo -e $comm | sed -e 's/_/X/g' -e 's/:/X/g' -e 's/\//X/g'  -e 's/-/X/g')"

                        #Adaptamos memoria a algo legible
                        peso=$(mostrarPesoEnHumano "${listaPesos[i]}")
                        peso="\`$peso\`"

                        #Generar lista
                        respuestaIa="$respuestaIa\($peso\) ${listaNombres[i]} $comm\n\n"
                    done
                    ;;
                /status)
                    respuestaIa="No imlementat de moment..."
                    ;;
                /hw)
                    respuestaIa=$(hostnamectl && lscpu | grep "Nombre del modelo:" && lscpu | grep "CPU(s):" && lscpu | grep "Operating System" && lscpu | grep "Kernel" )
                    ;;
                /clear)
                    contexto=""
                    > "./contexto/ctxt$idAutor.txt"
                    respuestaIa="Context de $nombre($idAutor) borrat"
                    ;;
                /run*)
                    #Obtenemos nombres reales
                    respuestaIa=$( curl -s http://localhost:11434/api/tags )
                    nombres=$(echo $respuestaIa | jq -r '.models[].name')
                    #Convertir lineas en elementos de un vector
                    IFS=$'\n'   # separador = espacio
                    read -r -d '' -a listaNombres <<< "$nombres"
                    #Comparar lista de comandos
                    encontrado=0
                    for i in "${!listaNombres[@]}"; do
                        #Generar comandos
                        nom="run_${listaNombres[i]}"

                        #Traducir con mismo escapado
                        nom="/$(echo -e $nom | sed -e 's/_/X/g' -e 's/:/X/g' -e 's/\//X/g'  -e 's/-/X/g')"

                        #Comparamos con comando introducido
                        if [ "$nom" = "$texto" ]; then
                            #Si alguno es igual
                            modelo=${listaNombres[i]}
                            encontrado="1"
                        fi
                    done
                    #Si lo hemos encontrado actuamos
                    if (( "$encontrado" == "1" )); then
                        respuestaIa="Ara s'usará el model $modelo."
                    else
                        respuestaIa="No existeix el modelo $texto, selecciona un dels existents. Es mante el model actual: $modelo"
                    fi
                    ;;
                /last)
                    respuestaIa=$(cat ./temp/temp.temp)
                    ;;
                /apagar)
                    if [[  "$idAutor" == "$idAlex" ]]; then
                        bitReset=1
                    else
                        respuestaIa="No tens permis per a executar el comandament $texto"
                    fi
                    ;;
                /reiniciar)
                    if [[  "$idAutor" == "$idAlex" ]]; then
                        #Creamos nueva instancia (la anterior se autodestruirá)
                        segundoPlano ./meritxell.api

                        #Activo el bit de reset
                        bitReset=1
                    else
                        respuestaIa="No tens permis per a executar el comandament $texto"
                    fi
                    ;;
                /reset)
                    if [[  "$idAutor" == "$idAlex" ]]; then
                        #Borramos todos los registros y archivos temporales
                        rm -rf ./contexto ./img ./interno ./temp

                        #Creamos nueva instancia (la anterior se autodestruirá)
                        segundoPlano ./meritxell.api

                        #Activo el bit de reset
                        bitReset=1
                    else
                        respuestaIa="No tens permis per a executar el comandament $texto"
                    fi
                    ;;
                /*)
                    respuestaIa="No existeix el comandament $texto. Proba amb /help"
                    ;;
                *)
                        #pasa a ollama
                    fecha $colorOllama
                    echo "Pasando mensaje a Ollama"
                    #Si es una imagen
                    if [[ "$idImagen" != "null" && "$idImagen" != "" ]]; then
                        #Informando a terminal
                        fecha $colorTelegram
                        echo "Descargando imagen de telegram"
                        #Descarga de la imagen
                        rutaImagen=$(descargarImagen "$idImagen" "$botToken" "$idAutor")
                        #Informando a terminal
                        fecha $colorOllama
                        echo "Pasando imagen a Ollama"
                        #Pasamos imagen a ollama
                        respuestaIa=$(llamadaModeloImagen "$colorOllama" "$modelo" "$contexto" "$comentarioFoto" "$botToken" "$chatOrigen" "$idAutor" "$rutaImagen")
                    elif [[ "$texto" != "null" && "$texto" != "" ]]; then  #Si es un texto
                        #Si es texto
                        fecha $colorOllama
                        echo "Procesando texto"
                        respuestaIa=$(llamadaModelo "$colorOllama" "$modelo" "$contexto" "$texto" "$botToken" "$chatOrigen" "$idAutor")
                    else
                        fecha $colorAviso
                        echo "No es imagen ni texto"
                    fi

                    texto=""
                    idImagen=""
                    comentarioFoto=""
                    ;;
            esac

            #Avisa de que el mensaje ya se ha redactado
            fecha $colorTelegram
            echo "Mensaje redactado"


                # Enviando texto generado
            #Avisa de que se está enviando el mensaje
            fecha $colorTelegram
            echo -e "Meritxell está respondiendo en Telegram..."

            #Escapamos todo el texto
            respuestaIa=$(escaparMarkdown "$respuestaIa")

            #Devuelve respuesta por telegram
            enviarMensaje "$botToken" "$chatOrigen" "$respuestaIa" "$idMensaje"

            #Avisa de que se ha enviado el mensaje
            fecha $colorTelegram
            echo "Mensaje enviado"

            #Guardamos última consulta
            echo -e "\n\tPREGUNTA:\n$texto" > ./temp/temp.temp
            echo -e "\n\n\tRESPUESTA:\n$respuestaIa\n\n ### fin ###" >> ./temp/temp.temp

            #Vaciamos la variable para evitar errores
            respuestaIa=""

        else
            fecha $colorAviso
            echo "Usuario sin identificar >$idAutor< >$nombre< >$apellido<"
            echo "Usuario sin identificar >$idAutor< >$nombre< >$apellido<" >> ./interno/listaN
        fi
    else
        fecha $colorTelegram
        echo "No ha habido nuevos mensajes..."
    fi
done






