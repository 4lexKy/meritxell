#!/bin/bash

#FUNCIONAAAA
# # Construir JSON con jq para evitar problemas de comillas
# JSON=$(jq -n \
#   --arg chat_id "$chatOrigen" \
#   '{
#     chat_id: $chat_id,
#     text: "📱 Tipos de botones inline:",
